# --- Cloudinary (media uploads) ----------------------------------------------
# Needed: Uploads phase (lesson videos, course thumbnails).
# Cloudinary console → Dashboard → Product environment credentials.
# Uploads will be signed on the server; the API secret must stay server-only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=doesbjmnj
CLOUDINARY_API_KEY=459462382669858
CLOUDINARY_API_SECRET=Gglm1xIM1N7ZsiNP5Xk7nPTo3fQ
# Optional: folder that uploaded assets are stored under.
CLOUDINARY_UPLOAD_FOLDER=swaranjanam


# --- Razorpay (payments) -----------------------------------------------------
# Needed: Payments phase (future). Use test-mode keys (rzp_test_...) until launch.
# Razorpay dashboard → Account & Settings → API Keys / Webhooks.
# The key ID (starts with rzp_test_ or rzp_live_) is shown to the browser in
# Checkout; the secrets are server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
