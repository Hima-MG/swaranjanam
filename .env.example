# -----------------------------------------------------------------------------
# Swaranjanam — environment variables (PLACEHOLDERS ONLY)
#
# Copy to `.env.local` for local development and fill in real values there:
#   cp .env.example .env.local
# On Vercel: Project → Settings → Environment Variables.
#
# !! NEVER put real values in THIS file — it is committed to a public repo. !!
#
# NEXT_PUBLIC_* values are embedded in the browser bundle. Everything else is
# server-only; never prefix a secret with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------


# --- Site --------------------------------------------------------------------
# Needed: now. Production URL on Vercel; also accepted as a trusted Origin for
# the session endpoint's CSRF check.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: the academy's YouTube channel URL. The footer/contact link stays
# hidden until this is set.
NEXT_PUBLIC_YOUTUBE_URL=


# --- Firebase client SDK (Phase 3: Authentication) ---------------------------
# Firebase console → Project settings → General → Your apps → Web app config.
# Public by design; access is enforced by Firebase Auth and security rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# --- Firebase Admin SDK (Phase 3: Authentication) — SERVER-ONLY SECRET -------
# Firebase console → Project settings → Service accounts → Generate new private
# key. Copy the three fields from the JSON, then DELETE the JSON file.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# One line, wrapped in double quotes, with literal \n between key lines, e.g.
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional: session cookie lifetime in days (1–14, default 5).
SESSION_COOKIE_MAX_AGE_DAYS=5


# --- Cloudinary (course media) -----------------------------------------------
# Cloudinary console → Settings → API Keys. The API secret is server-only:
# uploads are signed on the server and verified with the Admin API.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=swaranjanam


# --- Razorpay (Standard Checkout) — KEY SECRET + WEBHOOK SECRET ARE SERVER-ONLY ---
# Razorpay Dashboard → Account & Settings → API Keys / Webhooks. The MODE follows
# the key id: rzp_test_… = Test Mode (no real money), rzp_live_… = Live Mode.
# Generate the key AND the webhook in the SAME mode (the dashboard's Test/Live
# toggle). Leave the key empty to disable online payments (manual payments work).
# Webhook URL: https://<your-domain>/api/payments/razorpay/webhook
#   events: payment.captured, order.paid, payment.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional, public: the same key id as RAZORPAY_KEY_ID (the server refuses a
# mismatch). Checkout receives the key id from the server either way.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# FAIL-CLOSED environment separation:
#   * Test Mode payments are recorded ONLY when the server's Firebase project
#     (FIREBASE_ADMIN_PROJECT_ID) is an emulator project (demo-…) or is listed
#     here (comma-separated non-production projects, e.g. a staging project).
#   * Live Mode keys are REFUSED on those projects (emulator or listed here).
# NEVER list the production project.
RAZORPAY_TEST_FIREBASE_PROJECTS=

# --- Transactional email (Resend) — RESEND_API_KEY IS A SERVER-ONLY SECRET ---------
# Resend dashboard → API Keys (sending access). EMAIL_FROM must use a domain verified
# in Resend, e.g. "Swaraanjanam <notifications@your-verified-domain>". Empty = emails
# are queued in Firestore (emailOutbox) and retried by the scheduled job once set.
# Never prefix with NEXT_PUBLIC_. With the Firebase emulator, emails are only logged
# unless EMAIL_SEND_IN_EMULATOR=true.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: where student replies go.
EMAIL_REPLY_TO=

# --- Scheduled billing job ---------------------------------------------------
# Long random string. Vercel Cron (vercel.json) calls /api/cron/billing daily with
# "Authorization: Bearer <CRON_SECRET>". Empty = the endpoint is disabled (503).
CRON_SECRET=
