# -----------------------------------------------------------------------------
# Swaranjanam — environment variables
#
# Copy this file to `.env.local` for local development and fill in real values:
#   cp .env.example .env.local
# On Vercel, add the same variables under Project → Settings → Environment Variables.
#
# NEVER commit real values. `.env.local` and other `.env*` files are git-ignored;
# only this placeholder file is tracked.
#
# Variables prefixed with NEXT_PUBLIC_ are embedded in the browser bundle and are
# visible to anyone. Everything else is server-only — do not prefix secrets with
# NEXT_PUBLIC_.
# -----------------------------------------------------------------------------


# --- Site --------------------------------------------------------------------
# Needed: now (used for metadata / canonical URLs). Defaults to
# http://localhost:3000 when unset. Set to the production URL on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Firebase client SDK -----------------------------------------------------
# Needed: Firebase setup & Authentication phase.
# Firebase console → Project settings → General → Your apps → Web app config.
# These identify the project to the browser; they are public by design.
# Access is enforced by Firebase Auth and Firestore security rules.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyB5GDtfPQe-fBHQutWAbQMcL4Bc12uRlus
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=swaranjanam.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=swaranjanam
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=swaranjanam.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=1:641447887180:web:5056d079192117a72e0fe9


# --- Firebase Admin SDK (server-only, SECRET) --------------------------------
# Needed: Firebase setup & Authentication phase (session cookies, role checks,
# server-side Firestore access).
# Firebase console → Project settings → Service accounts → Generate new private key.
# Copy the three fields below from the downloaded JSON, then delete the JSON file
# (never commit it).
FIREBASE_ADMIN_PROJECT_ID=swaranjanam
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-fbsvc@swaranjanam.iam.gserviceaccount.com
# Keep the surrounding quotes and the literal \n sequences on one line, e.g.
# "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
