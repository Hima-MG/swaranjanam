rules_version = '2';

// Swaraanjanam Firestore security rules.
//
// Data model (see src/lib/lms/types.ts):
//   users/{uid}                          profile; role mirrors the auth custom claim
//   courses/{courseId}                   teacherIds[], status: draft | published
//   modules/{moduleId}                   courseId, order
//   lessons/{lessonId}                   courseId, moduleId, order, resources[]
//   enrollments/{courseId}_{studentId}   status: active | revoked
//   lessonProgress/{studentId}_{lessonId}
//   payments/{autoId}                    teacher-only (server); no client access
//   submissions/{autoId}                 server only; students see their own via the app
//   reviews/{courseId}_{studentId}       server only; moderated by teachers
//   announcements/{autoId}               server only; students see theirs via the app
//   liveClasses/{autoId}                 server only; students see their own via the app
//   auditLogs/{autoId}                   teacher-only (server); no client access
//   testimonials/{autoId}                server only; public site shows approved + consented
//                                        ones through the app. Covered by the catch-all deny.
//   pricePlans, packages, creditLedger,  billing (server only): no client access.
//   billingAdjustments, receipts,        Students see their own packages, payments
//   paymentReferences, settings          and receipts only through the app, which
//                                        checks ownership on the server. Covered by
//                                        the catch-all deny below.
//
// Principles:
//   * Deny by default.
//   * NO client writes anywhere. Every write goes through server code using
//     the Admin SDK, which bypasses these rules and performs its own
//     authorisation (src/lib/lms/server/access.ts). Users therefore cannot
//     change roles, enroll themselves, or edit course content from a browser.
//   * Reads are narrowly scoped so that even a direct client SDK call can
//     only see what the server would show that user. Lesson documents carry
//     resource URLs, so reading them requires an active enrollment in a
//     published course, or the teacher role.
//   * The teacher role is the `role` custom claim ("teacher", or the legacy
//     "admin"), set only by trusted tooling (scripts/set-role.mjs). Teachers
//     administer the whole academy: any teacher may read any course.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() && request.auth.token.role in ["teacher", "admin"];
    }

    function course(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data;
    }

    function teachesCourse(courseId) {
      return isTeacher() && exists(/databases/$(database)/documents/courses/$(courseId));
    }

    function enrolledIn(courseId) {
      let path = /databases/$(database)/documents/enrollments/$(courseId + "_" + request.auth.uid);
      return isSignedIn()
        && exists(path)
        && get(path).data.status == "active"
        && course(courseId).status in ["published", "archived"];
    }

    match /users/{uid} {
      // Own profile only. Teacher views of students are built on the server.
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    match /courses/{courseId} {
      allow get: if teachesCourse(courseId) || enrolledIn(courseId);
      allow list: if false;
      allow write: if false;
    }

    match /modules/{moduleId} {
      allow get: if teachesCourse(resource.data.courseId) || enrolledIn(resource.data.courseId);
      allow list: if false;
      allow write: if false;
    }

    match /lessons/{lessonId} {
      allow get: if teachesCourse(resource.data.courseId) || enrolledIn(resource.data.courseId);
      allow list: if false;
      allow write: if false;
    }

    match /enrollments/{enrollmentId} {
      allow get: if isSignedIn()
        && (resource.data.studentId == request.auth.uid || teachesCourse(resource.data.courseId));
      allow list: if false;
      // Students can never create or modify enrollments.
      allow write: if false;
    }

    match /lessonProgress/{progressId} {
      allow get: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow list: if false;
      allow write: if false;
    }

    // Explicit catch-all deny for every other collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
